import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import make_moons
from sklearn.model_selection import train_test_split
from tensorflow.keras import Sequential, layers

X, y = make_moons(n_samples=1000, noise=0.1, random_state=42)
a, b, c, d = train_test_split(X, y, test_size=0.2)

model = Sequential([
    layers.Input(shape=(2,)),
    layers.Dense(100, activation="relu"),
    layers.Dense(50, activation="relu"),
    layers.Dense(1, activation="sigmoid")
])

model.compile("adam", "binary_crossentropy", metrics=["accuracy"])
model.fit(a, c, epochs=50, verbose=0)

print(model.evaluate(b, d, verbose=0))

xx, yy = np.meshgrid(
    np.arange(-2, 3, 0.02),
    np.arange(-1.5, 2, 0.02)
)

Z = model.predict(np.c_[xx.ravel(), yy.ravel()], verbose=0)
Z = Z.reshape(xx.shape).round()

plt.contourf(xx, yy, Z, alpha=0.7)
plt.scatter(b[:, 0], b[:, 1], c=d)
plt.title("DNN Decision Boundary")
plt.show()